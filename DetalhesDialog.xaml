<Window
    x:Class="AgendaLicitacoes.DetalhesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgendaLicitacoes"
    Title="Detalhes da Licitação"
    Width="900"
    Height="700">

    <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource BgBrush}">
        <!-- Header with status color -->
        <Border 
            x:Name="HeaderBorder"
            Grid.Row="0"
            Height="80"
            Background="{StaticResource AccentBrush}"
            Padding="16">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Vertical" Spacing="4">
                    <TextBlock 
                        x:Name="HeaderTitle"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"/>
                    <TextBlock 
                        x:Name="HeaderSubtitle"
                        FontSize="12"
                        Foreground="White"
                        Opacity="0.9"/>
                </StackPanel>
                
                <StackPanel 
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button Content="Linkar Ata" Click="BtnLinkAta_Click"/>
                    <Button Content="Editar" Click="BtnEdit_Click"/>
                    <Button Content="📁 Pasta" Click="BtnFolder_Click"/>
                    <Button Content="Excluir" Click="BtnDelete_Click" Background="Red"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Info strip -->
        <Border
            Grid.Row="0"
            VerticalAlignment="Bottom"
            Background="{StaticResource MidBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16">
            <TextBlock 
                x:Name="InfoStrip"
                FontSize="11"
                Foreground="{StaticResource MutedBrush}"/>
        </Border>

        <!-- Tab content -->
        <TabView 
            Grid.Row="1"
            Margin="0">
            <!-- Diário Tab -->
            <TabViewItem Header="Diário">
                <Grid RowDefinitions="Auto,*,Auto" Padding="16">
                    <CommandBar Grid.Row="0" Background="Transparent">
                        <AppBarButton Label="Adicionar Nota" Icon="Add" Click="AddNote_Click"/>
                        <AppBarButton Label="Salvar" Icon="Save" Click="SaveDiary_Click"/>
                    </CommandBar>
                    <RichEditBox 
                        x:Name="DiarioxEdit"
                        Grid.Row="1"
                        Margin="0,8,0,0"/>
                </Grid>
            </TabViewItem>

            <!-- Itens Tab -->
            <TabViewItem Header="Itens">
                <Grid RowDefinitions="Auto,*" Padding="16">
                    <CommandBar Grid.Row="0" Background="Transparent">
                        <AppBarButton Label="Adicionar" Icon="Add" Click="AddItem_Click"/>
                        <AppBarButton Label="Editar" Icon="Edit" Click="EditItem_Click"/>
                        <AppBarButton Label="Remover" Icon="Delete" Click="RemoveItem_Click"/>
                        <AppBarSeparator/>
                        <AppBarButton Label="Marcar Ganho" Click="MarkItemsWon_Click"/>
                        <AppBarButton Label="Marcar Perdido" Click="MarkItemsLost_Click"/>
                    </CommandBar>
                    <DataGrid 
                        x:Name="ItensGrid"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="60"/>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                            <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="60"/>
                            <DataGridTextColumn Header="Un." Binding="{Binding Unidade}" Width="50"/>
                            <DataGridTextColumn Header="V. Unit." Binding="{Binding ValorUnitario}" Width="80"/>
                            <DataGridTextColumn Header="V. Total" Binding="{Binding ValorTotal}" Width="80"/>
                            <DataGridTextColumn Header="Resultado" Binding="{Binding Ganho}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabViewItem>

            <!-- Anexos Tab -->
            <TabViewItem Header="Anexos">
                <Grid RowDefinitions="Auto,*" Padding="16">
                    <CommandBar Grid.Row="0" Background="Transparent">
                        <AppBarButton Label="Adicionar" Icon="Add" Click="AddAttachment_Click"/>
                        <AppBarButton Label="Abrir" Icon="OpenFile" Click="OpenAttachment_Click"/>
                        <AppBarButton Label="Remover" Icon="Delete" Click="RemoveAttachment_Click"/>
                    </CommandBar>
                    <DataGrid 
                        x:Name="AnexosGrid"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="200"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/>
                            <DataGridTextColumn Header="Data Adicionado" Binding="{Binding DataAdd}" Width="120"/>
                            <DataGridTextColumn Header="Caminho" Binding="{Binding Caminho}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabViewItem>

            <!-- Histórico Tab -->
            <TabViewItem Header="Histórico">
                <Grid Padding="16">
                    <DataGrid 
                        x:Name="HistoricoGrid"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="False"
                        IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora}" Width="150"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                            <DataGridTextColumn Header="Usuário" Binding="{Binding Usuario}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabViewItem>
        </TabView>

        <!-- Footer -->
        <Border
            Grid.Row="2"
            Background="{StaticResource MidBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16">
            <TextBlock 
                x:Name="FooterInfo"
                FontSize="10"
                Foreground="{StaticResource MutedBrush}"/>
        </Border>
    </Grid>
</Window>
